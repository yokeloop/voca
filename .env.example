# VOCA stand settings. This is a bash file: only scripts/*.sh read it, through
# scripts/env.sh. Each line keeps a value already set in the environment.
# devkey/secret are the built-in keys of `livekit-server --dev`; they cannot be
# changed without a livekit-server config.

# Root of downloaded tools: <root>/<tool>/<version>/ (scripts/SHA256SUMS "apps").
VOCA_APPS_DIR="${VOCA_APPS_DIR:-$HOME/Apps}"
# Root of downloaded models (scripts/SHA256SUMS "models").
VOCA_MODELS_DIR="${VOCA_MODELS_DIR:-$HOME/models}"
# livekit-server release binary (scripts/fetch.sh puts it here).
VOCA_LIVEKIT_BIN="${VOCA_LIVEKIT_BIN:-$VOCA_APPS_DIR/livekit/1.13.11/livekit-server}"
# audio.cpp server release binary, CPU build 0.9.4 (scripts/fetch.sh puts it here).
VOCA_AUDIOCPP_BIN="${VOCA_AUDIOCPP_BIN:-$VOCA_APPS_DIR/audio.cpp/0.9.4/audiocpp_server}"
# llama-server of the llama.cpp CUDA release (scripts/fetch.sh puts it here; libraries sit next to it); b11869 is the build of the VOCA-4/5 measurements, kept in SHA256SUMS.
VOCA_LLAMA_BIN="${VOCA_LLAMA_BIN:-$VOCA_APPS_DIR/llama.cpp/llama-b12167/llama-server}"
# llama-server model profile: scripts/llm-profiles/<name>.sh (bolt-e4b, lfm3-1.7b, lfm2.5-2.6b); only this model is loaded.
VOCA_LLM_PROFILE="${VOCA_LLM_PROFILE:-bolt-e4b}"
# Address livekit-server announces for media (--node-ip).
VOCA_LIVEKIT_NODE_IP="${VOCA_LIVEKIT_NODE_IP:-127.0.0.1}"
# LiveKit API key that signs tokens (livekit-server --dev key).
VOCA_LIVEKIT_API_KEY="${VOCA_LIVEKIT_API_KEY:-devkey}"
# LiveKit API secret that signs tokens (livekit-server --dev secret).
VOCA_LIVEKIT_API_SECRET="${VOCA_LIVEKIT_API_SECRET:-secret}"
# Address voca web listens on.
VOCA_WEB_HOST="${VOCA_WEB_HOST:-127.0.0.1}"
# Port voca web listens on.
VOCA_WEB_PORT="${VOCA_WEB_PORT:-8083}"
# LiveKit URL the page receives with its token.
VOCA_PUBLIC_LIVEKIT_URL="${VOCA_PUBLIC_LIVEKIT_URL:-ws://127.0.0.1:7880}"

# voca.priney.com (deployment.md): uncomment to serve the stand over the tailnet.
# VOCA_WEB_HOST=100.108.140.49
# VOCA_LIVEKIT_NODE_IP=100.108.140.49
# VOCA_PUBLIC_LIVEKIT_URL=wss://voca.priney.com

# Hermes (VOCA-3, bench/hermes_runs.py): API server of the main Hermes profile; values in README "Воспроизведение с нуля" 0.4
# Hermes API URL; https://hermes.priney.com for the stand.
VOCA_HERMES_URL="${VOCA_HERMES_URL:-}"
# API_SERVER_KEY of the Hermes profile; never committed.
VOCA_HERMES_KEY="${VOCA_HERMES_KEY:-}"
